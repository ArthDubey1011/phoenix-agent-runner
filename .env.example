# Copy to .env. Never commit real keys.
POSTGRES_PASSWORD=phoenix
DATABASE_URL=postgresql://phoenix:phoenix@localhost:5433/phoenix
# Tests run against this database; its public schema is DROPPED and recreated.
PHOENIX_TEST_DATABASE_URL=postgresql://phoenix:phoenix@localhost:5433/phoenix_test
# Real LLM calls only when PHOENIX_REAL_LLM=1
PHOENIX_REAL_LLM=0
# Real provider: anthropic (default) or gemini (free tier key from Google AI Studio)
PHOENIX_PROVIDER=anthropic
GEMINI_API_KEY=
# Seconds between LLM requests; free tiers allow only a few per minute (13 ~ 5 per minute)
PHOENIX_MIN_REQUEST_INTERVAL_S=0
ANTHROPIC_API_KEY=
PHOENIX_MODEL=claude-haiku-4-5-20251001
